#!/bin/sh
# The README's false color: the hillshade of the mountain in a 1000x600
# window, zoomed to about 100% over the crater, and `r` pressed through the
# four color maps — gray, viridis, magma, turbo — a second on each. The
# zoom is done before the film starts; the film is the colors.
#
# The hillshade is opened alone rather than as one of its directory, which
# holds other pictures of the mountain that would change which file the
# steps land on; alone, it also comes up without the file list, which is
# shown only while there is more than one file.
#
#   ./false_color              on images/mora's hillshade
#   ./false_color FILE X Y     on another file, zooming into its pixel X, Y

. "$(dirname "$0")/lib.sh"

file=${1:-$ROOT/images/mora/mora_hillshade_12.5m.tif}
x=${2:-2340}
y=${3:-2260}

open 1000 600 "$file"
set -- $(magick identify -format '%w %h' "$file")
cursor $(fitted "$1" "$2" "$x" "$y")
sleep 0.3
# Seven notches from a fit of 23% is 109%.
wheel 7
settle

record "false_color.mp4"
started=$(since_record)
sleep 1
keys r
sleep 1
keys r
sleep 1
keys r
sleep 1
film=$(cut)
close
gif "$film" "false_color.gif" 800 "$started"
