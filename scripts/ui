#!/bin/sh
# The README's interface tour: four pictures of one mountain in a 1200x675
# window (16:9), the wheel turned two notches in on the summit, the pointer
# brought to the counter at the head of the top bar and held there for its
# tooltip, then down to the help button at the foot of the right strip and
# pressed, the table of keys it opens scrolled to its end over three
# seconds, Esc to close it, and the pointer taken up to the button at the
# end of the top bar that hides the interface, and that pressed. The
# pointer is in the film, since where it goes is the point, and it moves as
# a hand would, through device.py.
#
# The four are opened by name rather than as their directory, which holds
# other pictures of the mountain that would join them in the count.
#
#   scripts/ui                      on images/mora
#   scripts/ui FILE...              on other files

. "$(dirname "$0")/../lib.sh"

if [ $# -eq 0 ]; then
    set -- "$ROOT/images/mora/mora.jpg" \
        "$ROOT/images/mora/mora_dem_12.5m_utm10.tif" \
        "$ROOT/images/mora/mora_hillshade_12.5m.tif" \
        "$ROOT/images/mora/mora_relief_12.5m_smr50.png"
fi

open 1200 675 "$@"
# The file list comes up down the left with several files open; Tab puts
# it away, so that the tour is of the bars and the strips around the
# picture.
keys Tab
record "ui.mp4" cursor
started=$(since_record)
sleep 0.5

# A little way in on the summit first, so that when the interface is hidden
# at the end the picture fills the whole window rather than standing
# between bars: the photograph is 3:2 and the window 16:9, so it has to be
# past 64% to fill it across, and two notches from a fit of 49% is about
# 76%.
glide $(fitted 3008 2000 1500 340)
sleep 0.3
wheel 2
sleep 0.6

set -- $(window geometry)
# The counter sits between the two chevrons at the head of the top bar,
# after the file list's toggle, on the bar's centerline: a bar's padding,
# the toggle, a gap and the left chevron put its edge 57 across, and 70 is
# inside it whatever the count. The tooltip comes up half a second after
# the pointer stops, and is left up for two.
glide $(($1 + 70)) $(($2 + 15))
sleep 2.2

# The help button is the last of the right strip, a bar's padding up from
# the bottom bar and centered across the strip.
glide $(($1 + $3 - 15)) $(($2 + $4 - 45))
sleep 0.5
click
sleep 0.5

# The popup fills the middle of the window, and the wheel scrolls it only
# with the pointer over it, so the pointer goes to its middle, which is
# the window's. The table ends 26 notches down.
glide $(($1 + $3 / 2)) $(($2 + $4 / 2))
sleep 0.3
wheel -26 3
sleep 0.8
keys Escape
sleep 0.5

# The button that hides the interface ends the top bar, where the help
# button ends the right strip.
glide $(($1 + $3 - 15)) $(($2 + 15))
sleep 0.5
click
sleep 1
film=$(cut)
close
shown=$(clip "$film" "ui.mp4" "$started")
echo "$shown"
# The still that stands in for the film: the table of keys partway down.
poster "$shown" "ui_thumb.jpg" 10.5
