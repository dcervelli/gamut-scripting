#!/bin/sh
# The README's loupe: a robin in a 1200x675 window, the loupe's toggle in
# the bottom bar clicked, the pointer glided onto the bird's eye, Shift+L
# pressed round the magnifications — 4x, 8x, 16x, 2x and back to 4x — and
# then the toggle clicked off again; and the other way of having it, the
# pointer taken down to the bird's right foot and the right button held,
# which holds the loupe up for as long as it is down, and the pointer
# taken slowly up the toe to the ankle before it is let go. Shift+L goes
# through the device's keyboard, since wtype's capital reaches the window
# as `l` and takes the loupe down. The pointer is in the film, since the
# loupe sits beside it and the toggle is clicked.
#
#   scripts/loupe                  on images/robin.heic
#   scripts/loupe FILE X Y [FX FY [AX AY]]
#                      on another file, the loupe over pixel X, Y of it,
#                      then held up with the right button from FX, FY up
#                      to AX, AY

. "$(dirname "$0")/../lib.sh"

file=${1:-$ROOT/images/robin.heic}
# The eye.
x=${2:-2212}
y=${3:-1008}
# The forward toe of the right foot, and the ankle above it.
fx=${4:-2370}
fy=${5:-2495}
ax=${6:-2420}
ay=${7:-2355}

# The magnification is kept between runs, and the four presses go round
# from 4x back to it.
remember loupe_magnification 4
open 1200 675 "$file"
# One file rather than a directory, so no list comes up down the left and
# the four bars alone stand around the picture, which is where `fitted`
# looks for it.
set -- $(magick identify -format '%w %h' "$file")
keep_pointer

record "loupe.mp4" cursor
started=$(since_record)
sleep 0.5
# The loupe's toggle is third in the bottom bar, after the grid's and the
# horizon grid's: 22-wide buttons 8 apart from a padding of 4, so 75
# pixels in from the left edge, on the bar's centerline.
set -- "$1" "$2" $(window geometry)
toggle_x=$(($3 + 75))
toggle_y=$(($4 + $6 - 15))
glide "$toggle_x" "$toggle_y"
# Long enough on the button for its tooltip to come up and be read.
sleep 1.0
click
sleep 0.5
glide $(fitted "$1" "$2" "$x" "$y")
sleep 1.0
# The four presses are one gesture, 300 ms apart: a `press` each would
# make a device each, and half a second of that between them.
keyboard
gesture key shift+l -- rest 0.3 -- key shift+l -- rest 0.3 -- key shift+l -- rest 0.3 -- key shift+l
sleep 1.2
# The toggle again, to take the loupe down.
glide "$toggle_x" "$toggle_y"
sleep 0.4
click
sleep 0.6
# Down to the foot, and the right button held there: the loupe comes up
# for as long as the button is down. The walk up the toe to the ankle is
# a short one in the window — the picture is 4032 across in 1824 device
# pixels — so it is given two and a half seconds, which at 4x is the
# magnified view creeping the length of a foot.
glide $(fitted "$1" "$2" "$fx" "$fy")
sleep 0.6
gesture hold_along 2.5 \
    $(fitted "$1" "$2" $(((fx + ax) / 2)) $(((fy + ay) / 2))) \
    $(fitted "$1" "$2" "$ax" "$ay")
sleep 0.8
film=$(cut)
close
shown=$(clip "$film" "loupe.mp4" "$started")
echo "$shown"
# The still that stands in for the film: the loupe at 4x over the bird's
# eye, before Shift+L takes it round.
poster "$shown" "loupe_thumb.jpg" 5
# Cropped to the picture alone, still 16:9: a 4:3 picture fitted to this
# window leaves 304 device pixels of the window's own dark on either side
# of it, and taking those off leaves 1312 across, which is 738 down. What
# the height has to give is given at the foot, so that the crop sits at
# the top of the picture, where the loupe is.
magick "$SCREENSHOTS/loupe_thumb.jpg" -crop 1312x738+304+48 +repage \
    -quality 92 "$SCREENSHOTS/loupe_thumb.jpg"
