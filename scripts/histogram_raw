#!/bin/sh
# The histogram on a raw file: a Canon CR3 in a 1200x675 window (16:9),
# zoomed to 200% about the dragon's whisker, the histogram button in the
# right strip pressed and its column wheeled down to the foot, past the
# Develop section to Photosites, and the pointer taken briefly over the
# picture. Then the eye on the Photosites row pressed to lay the sensor's
# raw mosaic over the picture, the loupe turned on from the bottom bar, and
# the pointer taken along the edge of the right whisker, where bright meets
# dark and the mosaic's colors show most; the wheel turned three notches
# there, to about 400%, and Shift+M to take the mosaic off and show the
# developed picture under the same loupe. The pointer is in the film, since
# where it goes is the point, and it moves as a hand would, through
# device.py.
#
#   scripts/histogram_raw                  on images/kyoto.CR3

. "$(dirname "$0")/../lib.sh"

file=$ROOT/images/kyoto.CR3
# The picture as gamut shows it, upright: the sensor's 6022x4024 turned by
# the camera's orientation.
W=4024
H=6022

# Both kept between runs: the raw developed rather than the JPEG the camera
# put inside it, and the loupe at its least magnification.
remember camera_jpeg false
remember loupe_magnification 4
open 1200 675 "$file"
keep_pointer
# The pixel the zoom is about, which the `2` key keeps under the pointer.
set -- $(fitted "$W" "$H" 2751 2121)
ax=$1
ay=$2

record "histogram_raw.mp4" cursor
started=$(since_record)
sleep 1.0

# `2` is 200%, and holds the pixel under the pointer where it is.
glide "$ax" "$ay"
sleep 0.5
press 2
sleep 0.8

set -- $(window geometry)
# The histogram toggle is the first button of the right strip: centered
# across the strip, a bar's padding under the top bar. Long enough on it
# for its tooltip to be read.
glide $(($1 + $3 - 15)) $(($2 + 45))
sleep 0.8
click
sleep 0.5
# The column turned to its foot with the pointer over it, 200 in from the
# window's right edge, slowly enough to see what goes past: it has about
# three notches to give, and a fourth makes sure of the foot without
# leaving the wheel turning at nothing.
glide $(($1 + $3 - 200)) $(($2 + 300))
sleep 0.2
wheel -4 1.0
sleep 0.2

# The panel takes 294 off the right of the picture's area and the view
# keeps its middle, so the zoom's pixel is now half that to the left.
ax=$((ax - 147))
# Briefly over the picture, with the readout following, and then a second
# of creeping ten logical pixels, eight photosites at 200%, so that the
# Photosites grid can be seen stepping from one color's value to the next
# as the pointer crosses them.
gesture along 2.0 $((ax - 250)) $((ay - 80)) $((ax - 120)) $((ay + 160)) \
    $((ax + 40)) $((ay - 40)) -- along 1.0 $((ax + 50)) $((ay - 40))
sleep 0.2

# The eye at the right end of the Photosites row, at the foot of the
# column, lays the mosaic over the picture.
glide $(($1 + $3 - 60)) $(($2 + 547))
sleep 0.8
click
sleep 0.8
# The loupe's toggle is the third button of the bottom bar, after the
# grid's and the horizon grid's.
glide $(($1 + 75)) $(($2 + $4 - 15))
sleep 0.5
click
sleep 0.3

# Along the top edge of the right whisker's lower strand, where its lit
# side meets the dark behind it: offsets from the zoom's pixel in logical
# pixels at 200%, read off a still of this view.
glide $((ax + 158)) $((ay + 21))
sleep 0.3
gesture along 3.5 $((ax + 189)) $((ay + 38)) $((ax + 221)) $((ay + 51)) \
    $((ax + 252)) $((ay + 44)) $((ax + 283)) $((ay + 32))
sleep 0.4
# Three notches from 200% is about 400%, about the pointer, which stays on
# the edge: the trace stops where the edge still runs across the strand,
# short of where it turns up and the loupe would be over the dark alone.
wheel 3
sleep 1.0
# Shift+M takes the mosaic off: the same edge, developed.
press shift+m
sleep 2.0
film=$(cut)
close
shown=$(clip "$film" "histogram_raw.mp4" "$started")
echo "$shown"
# The still that stands in for the film: at about 400% with the mosaic
# up, the loupe on the whisker's edge showing the photosites' colors, and
# the panel's grid of values around the one under the pointer.
poster "$shown" "histogram_raw_thumb.jpg" 25.8
