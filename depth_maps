#!/bin/sh
# The README's depth maps: a spatial photo in a 1000x600 window, the depth
# toggle at the right end of the bottom bar clicked on and off with the
# pointer, and then the same map put up again from the keyboard with the
# information panel open beside it, where the map's own facts are written.
#
# Both ways round on purpose: the toggle is how the map is found, since it
# is drawn only for a file that carries one, and `D` is how it is worked
# once it has been. The panel is opened between them so that the second
# showing has the depth map's provenance and range next to it.
#
#   ./depth_maps            on images/depth/spatial_depth.heic
#   ./depth_maps FILE       on another file carrying a depth map

. "$(dirname "$0")/lib.sh"

file=${1:-$ROOT/images/depth/spatial_depth.heic}

open 1000 600 "$file"
keep_pointer

record "depth_maps.mp4" cursor
started=$(since_record)
sleep 0.5
# The depth toggle is the second thing in from the right end of the bottom
# bar, after the HDR switch: 4 + 42 + 12 pixels of padding, switch and gap
# take the bar to its left edge, and 11 more to its middle.
set -- $(window geometry)
glide $(($1 + $3 - 69)) $(($2 + $4 - 15))
# Long enough on the button for its tooltip to come up and be read.
sleep 1.0
click
sleep 1.0
click
# Off the button before the keys, so that its tooltip is not left standing
# over the panel the next press opens. The middle of the top bar is where
# the pointer shows in nothing.
glide $(($1 + $3 / 2)) $(($2 + 15))
sleep 1.0
keys i
# Longer than the toggle's beats: the panel is read rather than watched,
# and its depth map section is the point of opening it.
sleep 2.0
# Shift+D goes through the device's keyboard, since wtype's capital reaches
# the window as `d`, which is not a binding at all.
press shift+d
sleep 2.0
film=$(cut)
close
gif "$film" "depth_maps.gif" 800 "$started"
