#!/bin/sh
# Every picture, one script after another in the order the README lists
# them, each on its own defaults: for after the interface changes, when
# they all want taking again. Stops at the first that fails, and says
# which. GAMUT, SCREENSHOTS and FILMS pass through to each. Keep your hands
# off the keyboard for the whole run, as for any one of them.
#
#   ./all

set -eu

ROOT=$(cd "$(dirname "$0")" && pwd)

for script in main_screenshot animated pixel_grid pixel_copy info compare \
    false_color fuzzy_finder themes histogram mandelbrot ui; do
    echo "== $script"
    "$ROOT/$script" || { echo "$script failed" >&2; exit 1; }
done
